# Django
SECRET_KEY=replace-this-with-a-long-random-secret-key
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Supabase PostgreSQL Database
# Get these values from Supabase Project Settings -> Database
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your-supabase-db-password
DB_HOST=db.your-project-ref.supabase.co
DB_PORT=5432

# OR use a single connection string instead of the 5 fields above
# DATABASE_URL=postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres

# Media / Static (optional, for cloud storage in production)
USE_CLOUD_STORAGE=False
